# Copy to .env and fill locally. Never commit the real value.
DIGITALOCEAN_ACCESS_TOKEN=
OPENAI_API_KEY=

# Generated before starting the gateway; use a long random value.
DEFENSA_GATEWAY_TOKEN=

# Discord bot credentials; reuse only the narrowly scoped monitoring channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional Splunk integration configured in the next deployment phase.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=
