[Unit]
Description=Defensa Azul sensor forwarder (pilot paths)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/defensa-forwarder.env
ExecStart=/usr/bin/python3 /opt/defensa-forwarder/forwarder.py
Restart=always
RestartSec=5
User=root
StateDirectory=defensa-forwarder
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/defensa-forwarder
ReadOnlyPaths=/opt/ctf-stack/logs

[Install]
WantedBy=multi-user.target
