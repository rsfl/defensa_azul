{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defensa-azul.local/schemas/work-item.schema.json",
  "title": "Defensa Azul Agent Work Item",
  "type": "object",
  "required": ["task_id", "role_id", "skill", "event_id", "run_id", "created_at", "input_contract"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "target_id": {"type": ["string", "null"]},
    "incident_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "input_contract": {"const": "sanitized_event_ids_only"}
  },
  "additionalProperties": false
}

